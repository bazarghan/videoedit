# Copy to .env and chmod 600 .env. Choose a unique password before first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
PUBLIC_URL=https://video.example.com
COOKIE_SECURE=true
APP_PORT=8010
# Optional: Netscape cookies.txt for YouTube bot/age checks (see README).
# YTDLP_COOKIES_FILE=/data/youtube-cookies.txt
